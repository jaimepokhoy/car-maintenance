# Copy to .env.local and fill in from Supabase: Project Settings > API.
# The anon key is safe to ship in the app; row-level security protects the data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Places API (New) key for the shop finder. Restrict it to the app's
# bundle IDs and to the Places API in Google Cloud. Without it the Shops tab
# still shows saved shops but can't search nearby.
EXPO_PUBLIC_GOOGLE_PLACES_KEY=
